<!-- 首次打开：引导页 -->
<view class="onboarding" wx:if="{{needBirthday}}">
  <view class="onboarding-card">
    <view class="lang-toggle" bindtap="onToggleLang">{{langLabel}}</view>
    <view class="onboarding-title" style="background-image: {{gradient}};">{{t.appTitle}}</view>
    <view class="onboarding-sub">{{t.onboardSub}}</view>
    <view class="onboarding-demo">
      <view class="demo-row">
        <view
          class="demo-dot {{item.isNow ? 'demo-dot-now' : ''}}"
          style="background-color: {{item.color}}"
          wx:for="{{demoWeeks}}"
          wx:key="i"
        ></view>
      </view>
      <view class="demo-caption">{{t.demoCaption}}</view>
    </view>
    <picker
      mode="date"
      value="{{birthdate}}"
      start="1900-01-01"
      end="2100-12-31"
      bindchange="onOnboardDateChange"
    >
      <view class="onboarding-field">{{t.birthdateLabel}}{{birthdate}}</view>
    </picker>
    <picker
      mode="selector"
      range="{{lifespanLabels}}"
      value="{{lifespanIndex}}"
      bindchange="onOnboardLifespanChange"
    >
      <view class="onboarding-field">{{t.lifespanLabel}}{{lifespanLabels[lifespanIndex]}}</view>
    </picker>
    <button class="onboarding-btn" bindtap="onOnboardConfirm">{{t.onboardConfirm}}</button>
  </view>
</view>

<view class="container" wx:else>
  <view class="header">
    <view class="lang-toggle" bindtap="onToggleLang">{{langLabel}}</view>
    <view class="title" style="background-image: {{gradient}};">{{t.appTitle}}</view>
    <view class="subtitle">{{t.mainSub1}}</view>
    <view class="subtitle">{{t.mainSub2}}</view>
  </view>

  <view class="lifetimer">
    <view class="lifetimer-row">
      <text class="lifetimer-label">{{t.elapsedLabel}}</text>
      <text class="lifetimer-value lifetimer-elapsed"><block wx:for="{{elapsedParts}}" wx:for-item="p" wx:key="unit"><text class="lifetimer-num">{{p.num}}</text><text class="lifetimer-unit">{{p.unit}} </text></block><text class="lifetimer-sec">{{elapsedSec}}</text><text class="lifetimer-unit">{{t.secUnit}}</text></text>
    </view>
    <view class="lifetimer-row">
      <text class="lifetimer-label">{{t.remainLabel}}</text>
      <text class="lifetimer-value lifetimer-remain"><block wx:for="{{remainParts}}" wx:for-item="p" wx:key="unit"><text class="lifetimer-num">{{p.num}}</text><text class="lifetimer-unit">{{p.unit}} </text></block><text class="lifetimer-sec">{{remainSec}}</text><text class="lifetimer-unit">{{t.secUnit}}</text></text>
    </view>
  </view>

  <view class="progress-container">
    <view class="progress-bar-passed" style="width: {{passedPercent}}%;"></view>
    <view class="progress-bar-future" style="width: {{futurePercent}}%; background: {{gradient}};"></view>
  </view>

  <view class="progress-percent">{{t.passedPrefix}}{{stats.passedPercent}}</view>

  <view class="legend">
    <view class="legend-item">
      <view class="legend-dot legend-dot-passed"></view>
      <text class="legend-text">{{t.legendPassed}}</text>
    </view>
    <view class="legend-item">
      <view class="legend-dot legend-dot-future"></view>
      <text class="legend-text">{{t.legendFuture}}</text>
    </view>
    <view class="legend-item">
      <view class="legend-dot legend-dot-now"></view>
      <text class="legend-text">{{t.legendNow}}</text>
    </view>
    <view class="legend-item">
      <view class="legend-dot legend-dot-milestone"></view>
      <text class="legend-text">{{t.legendMilestone}}</text>
    </view>
    <text class="legend-tip">{{t.legendTip}}</text>
  </view>

  <view class="controls">
    <picker
      mode="date"
      value="{{birthdate}}"
      start="1900-01-01"
      end="2100-12-31"
      bindchange="onDateChange"
    >
      <view class="date-field">{{t.birthdayPrefix}}{{birthdate}}</view>
    </picker>
    <picker
      mode="selector"
      range="{{lifespanLabels}}"
      value="{{lifespanIndex}}"
      bindchange="onLifespanChange"
    >
      <view class="date-field">{{t.spanPrefix}}{{lifespanLabels[lifespanIndex]}}</view>
    </picker>
  </view>

  <view class="calendar-container">
    <view class="decade" wx:for="{{decades}}" wx:for-item="decade" wx:key="label">
      <view class="decade-label">{{decade.label}}</view>
      <view class="week-grid">
        <view
          class="week week-{{week.state}}"
          style="{{week.style}}"
          hover-class="week-hover"
          wx:for="{{decade.weeks}}"
          wx:for-item="week"
          wx:key="totalWeek"
          data-totalweek="{{week.totalWeek}}"
          bindtap="onWeekTap"
        ></view>
      </view>
    </view>
  </view>

  <view class="stat-cards">
    <view class="stat-card">
      <view class="stat-num">{{stats.passedWeeks}}</view>
      <view class="stat-label">{{t.passedWeeksLabel}}</view>
    </view>
    <view class="stat-card">
      <view class="stat-num">{{stats.remainWeeks}}</view>
      <view class="stat-label">{{stats.futureWeeksLabel}}</view>
    </view>
  </view>

  <view class="life-line">{{stats.lifeLine}}</view>

  <view class="actions">
    <button class="share-btn" open-type="share" hover-class="share-btn-hover">{{t.shareBtn}}</button>
    <button class="poster-btn" bindtap="onSavePoster" hover-class="poster-btn-hover">{{t.posterBtn}}</button>
  </view>

  <view class="quote">「{{quote}}」</view>

  <view class="footer">
    <view>{{t.footer}}</view>
  </view>

  <canvas type="2d" id="poster" class="poster-canvas"></canvas>
</view>
